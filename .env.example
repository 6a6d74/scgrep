# SCGRep configuration. Copy to `.env` and adjust.

# Required: name of this sensor centre instance.
SENSOR_CENTRE_ID=io-wis2dev-myinstance-sensor-centre-global-replay

# Required: 10-20 topics to test, a mix of notification and event topics.
SUBSCRIPTION_TOPICS=cache/a/wis2/ca-eccc-msc/data/core/weather/surface-based-observations/synop,monitor/a/wis2/ca-eccc-msc

# Comma-delimited MQTT URLs for the Global Brokers.
GLOBAL_BROKER_URLS=mqtts://everyone:everyone@globalbroker.meteo.fr:8883

# Global Replay services under test. The two lists must be the same length and
# correspond element-by-element.
GLOBAL_REPLAY_CENTRE_IDS=ca-eccc-msc-global-replay
GLOBAL_REPLAY_URLS=https://wis2-grep.weather.gc.ca

# Broker on which the Global Replay service delivers async replay messages.
# During the preoperational phase the GRep instance publishes replays to its own
# broker rather than the operational Global Brokers. NOTE: this direct-to-GRep-
# broker approach only works when testing a SINGLE Global Replay instance.
GLOBAL_REPLAY_BROKER_URL=mqtts://everyone:everyone@wis2-grep.weather.gc.ca:8883
# The GRep broker's TLS certificate is currently expired; skip verification.
GLOBAL_REPLAY_BROKER_TLS_INSECURE=true

# State store and metrics.
REDIS_URL=redis:6379
METRICS_ENDPOINT=/metrics
METRICS_PORT=8000

# Timing (seconds).
TIME_LAG=300
TEST_INTERVAL=300

# How long to wait for Redis to become reachable on startup (seconds).
REDIS_STARTUP_TIMEOUT=60

# LOG_LEVEL=INFO
