# SCGRep configuration. Copy to `.env` and adjust.

# Required: name of this sensor centre instance.
SENSOR_CENTRE_ID=io-wis2dev-myinstance-sensor-centre-global-replay

# Required: 10-20 topics to test, a mix of notification and event topics.
SUBSCRIPTION_TOPICS=cache/a/wis2/ca-eccc-msc/data/core/weather/surface-based-observations/synop,monitor/a/wis2/ca-eccc-msc

# Comma-delimited MQTT URLs for the Global Brokers.
GLOBAL_BROKER_URLS=mqtts://everyone:everyone@globalbroker.meteo.fr:8883

# Global Replay services under test. The two lists must be the same length and
# correspond element-by-element.
GLOBAL_REPLAY_CENTRE_IDS=ca-eccc-msc-global-replay
GLOBAL_REPLAY_URLS=https://wis2-grep.weather.gc.ca

# Comma-delimited broker(s) on which the Global Replay service delivers async
# replay messages (one during this preoperational phase). The GRep instance
# publishes replays to its own broker rather than the operational Global Brokers.
# Leave blank to receive replays via the Global Brokers (GLOBAL_BROKER_URLS)
# themselves — the operational case.
GLOBAL_REPLAY_BROKER_URLS=mqtts://everyone:everyone@wis2-grep.weather.gc.ca:8883
# Skip TLS verification for the replay broker. Only needed if its certificate
# lapses; the broker currently presents a valid certificate.
GLOBAL_REPLAY_BROKER_TLS_INSECURE=false

# State store and metrics.
REDIS_URL=redis:6379
METRICS_ENDPOINT=/metrics
METRICS_PORT=8000

# Timing (seconds).
TIME_LAG=300
TEST_INTERVAL=300

# How long to wait for Redis to become reachable on startup (seconds).
REDIS_STARTUP_TIMEOUT=60

# Logging. The detailed activity logs are emitted at INFO (on by default); set
# LOG_LEVEL=WARNING to silence them and keep only warnings/errors.
# LOG_LEVEL=INFO
# Max characters of an HTTP response body written to the log (longer is truncated).
LOG_HTTP_RESPONSE_MAX_CHARS=1000
