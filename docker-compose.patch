-# SCGRep deployment (self-contained).
+# SCGRep deployment — uses shared infrastructure from /Users/jeremytandy/docker/compose/
+# (traefik, redis, prometheus, grafana are provided externally).
 #
-# This stack runs everything it needs: a managed Redis, the SCGRep service, and
-# a Traefik reverse proxy. All three share a single Compose-managed bridge
-# network named "traefik".
-#
-# SCGRep waits for Redis via `depends_on` (Redis has a healthcheck), and reaches
-# it at redis:6379. Ingress is handled by Traefik using the file provider
-# (./traefik/dynamic.yml); SCGRep does not publish its port directly. With the
-# defaults below:
-#
-#   http://localhost/metrics     (metrics, via Traefik on :80)
-#   http://localhost/dashboard/  (Traefik dashboard, behind HTTP basic auth)
-#
-#   docker compose up --build
+#   docker compose up -d
 
 services:
-  traefik:
-    image: traefik:v3.1
-    container_name: traefik
-    restart: unless-stopped
-    command:
-      # File provider (no docker socket needed): routing is defined in
-      # ./traefik/dynamic.yml, which points at the scgrep service by name and
-      # exposes the dashboard behind HTTP basic auth.
-      - "--providers.file.filename=/etc/traefik/dynamic.yml"
-      - "--providers.file.watch=true"
-      - "--entrypoints.web.address=:80"
-      # Redirect all plain HTTP to HTTPS so endpoints are published over TLS.
-      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
-      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
-      - "--entrypoints.websecure.address=:443"
-      # Dashboard enabled but NOT insecure: it is served through the `websecure`
-      # entrypoint behind the basic-auth middleware (see dynamic.yml).
-      - "--api.dashboard=true"
-      # Liveness endpoint (/ping) used by the container healthcheck below.
-      - "--ping=true"
-    ports:
-      - "80:80"
-      - "443:443"
-    volumes:
-      - ./traefik/dynamic.yml:/etc/traefik/dynamic.yml:ro
-      # Gitignored basic-auth credentials; create from the example first:
-      #   cp traefik/dashboard-users.example traefik/dashboard-users
-      - ./traefik/dashboard-users:/etc/traefik/dashboard-users:ro
-      # Gitignored mkcert TLS certificates (see README). If absent, Traefik falls
-      # back to its self-signed default certificate.
-      - ./traefik/certs:/etc/traefik/certs:ro
-    healthcheck:
-      # The distroless Traefik image ships no shell/curl; use its built-in
-      # healthcheck CLI against the /ping endpoint enabled above.
-      test: ["CMD", "traefik", "healthcheck", "--ping"]
-      interval: 10s
-      timeout: 5s
-      retries: 3
-      start_period: 5s
-    networks:
-      - traefik
-
-  redis:
