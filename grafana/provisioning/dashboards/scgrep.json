{
  "uid": "scgrep-overview",
  "title": "SCGRep - Global Replay performance",
  "tags": ["scgrep", "wis2"],
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "centre_id",
        "label": "Global Replay service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(wmo_wis2_scgrep_messages_fetched_during_interval_total, centre_id)",
        "query": "label_values(wmo_wis2_scgrep_messages_fetched_during_interval_total, centre_id)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "type": "query",
        "name": "topic",
        "label": "Topic(s)",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\"}, topic)",
        "query": "label_values(wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\"}, topic)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1. Totals - messages per interval",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_messages_received_during_interval_total{topic=~\"$topic\"}", "legendFormat": "received - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2. Differences - baseline minus fetched",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_messages_received_during_interval_total{topic=~\"$topic\"} - on(report_by, topic) group_right() wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "received - http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_messages_received_during_interval_total{topic=~\"$topic\"} - on(report_by, topic) group_right() wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "received - mqtt - {{topic}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "3. Differences - percentage of baseline",
      "description": "Panel 2 as a percentage of the baseline: 100 * (received - fetched) / received. 0% is a perfect match; positive = the service returned fewer messages than the baseline. Undefined (no line) when the baseline is zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (1 - wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"} / on(report_by, topic) group_left() wmo_wis2_scgrep_messages_received_during_interval_total{topic=~\"$topic\"})", "legendFormat": "received - http (%) - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (1 - wmo_wis2_scgrep_messages_fetched_during_interval_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"} / on(report_by, topic) group_left() wmo_wis2_scgrep_messages_received_during_interval_total{topic=~\"$topic\"})", "legendFormat": "received - mqtt (%) - {{topic}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "4. Timeliness - fetch delay",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_fetch_delay_time{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_fetch_delay_time{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5. Test status - aborted flag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_test_aborted_flag{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_test_aborted_flag{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "6. Format validation - invalid format flag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_response_invalid_format_flag{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_response_invalid_format_flag{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "7. Synchronous fetch validation - invalid numberMatched",
      "description": "1 when the number of messages returned by the synchronous (http) fetch did not equal numberMatched. Applies to the synchronous fetch only.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_response_invalid_numberMatched_flag{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" }
      ]
    }
  ]
}
