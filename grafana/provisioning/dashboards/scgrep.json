{
  "uid": "scgrep-overview",
  "title": "SCGRep - Global Replay performance",
  "tags": ["scgrep", "wis2"],
  "schemaVersion": 39,
  "version": 11,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "centre_id",
        "label": "Global Replay service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(wmo_wis2_scgrep_messages_fetched_total, centre_id)",
        "query": "label_values(wmo_wis2_scgrep_messages_fetched_total, centre_id)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "type": "query",
        "name": "topic",
        "label": "Topic(s)",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\"}, topic)",
        "query": "label_values(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\"}, topic)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1. Totals - messages per interval",
      "description": "Per-interval message counts: the exact 60s counter delta (X - X offset 60s, clamped at 0 across restarts), so each point is the integer count for one test period.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "clamp_min(wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} - wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} offset 60s, 0)", "legendFormat": "received - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "clamp_min(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"} - wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"} offset 60s, 0)", "legendFormat": "http - {{topic}}" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "clamp_min(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"} - wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"} offset 60s, 0)", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2. Differences - baseline minus fetched",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "clamp_min(wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} - wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} offset 60s, 0) - on(report_by, topic) group_right() clamp_min(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"} - wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"} offset 60s, 0)", "legendFormat": "received - http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "clamp_min(wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} - wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} offset 60s, 0) - on(report_by, topic) group_right() clamp_min(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"} - wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"} offset 60s, 0)", "legendFormat": "received - mqtt - {{topic}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "3. Differences - percentage of baseline",
      "description": "Panel 2 as a percentage of the baseline: 100 * (received - fetched) / received. 0% is a perfect match; positive = the service returned fewer messages than the baseline. Undefined (no line) when the baseline is zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (1 - clamp_min(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"} - wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"} offset 60s, 0) / on(report_by, topic) group_left() clamp_min(wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} - wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} offset 60s, 0))", "legendFormat": "received - http (%) - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * (1 - clamp_min(wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"} - wmo_wis2_scgrep_messages_fetched_total{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"} offset 60s, 0) / on(report_by, topic) group_left() clamp_min(wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} - wmo_wis2_scgrep_messages_received_total{topic=~\"$topic\"} offset 60s, 0))", "legendFormat": "received - mqtt (%) - {{topic}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "4. Timeliness - fetch delay",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_fetch_delay_time{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_fetch_delay_time{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5. Test status - aborted flag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_test_aborted_flag{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_test_aborted_flag{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "6. Format validation - invalid format flag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_response_invalid_format_flag{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_response_invalid_format_flag{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "7. Synchronous fetch validation - invalid numberMatched",
      "description": "1 when the number of messages returned by the synchronous (http) fetch did not equal numberMatched. Applies to the synchronous fetch only.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 1, "fillOpacity": 20, "showPoints": "auto", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_response_invalid_numberMatched_flag{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "8. HTTP response code",
      "description": "HTTP status code of each test's request — the synchronous Features GET (last page when paging) and the asynchronous Processes POST. 200 = OK; 4xx/5xx = a replay-service error (e.g. an HTML gateway page); 0 = no response (connection failure/timeout).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 42 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 200 }, { "color": "red", "value": 300 } ] },
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false, "thresholdsStyle": { "mode": "off" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_http_response_code_value{centre_id=\"$centre_id\", protocol=\"http\", topic=~\"$topic\"}", "legendFormat": "http - {{topic}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_http_response_code_value{centre_id=\"$centre_id\", protocol=\"mqtt\", topic=~\"$topic\"}", "legendFormat": "mqtt - {{topic}}" }
      ]
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "9. Broker connections",
      "description": "MQTT connection status per broker (Global Broker and Global Replay broker). Green = connected (1), red = disconnected (0). Independent of the centre_id/topic selectors. Use it to rule out local connectivity when a replay test looks broken.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "60s",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 48 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "disconnected" }, "1": { "text": "connected" } } }
          ],
          "custom": { "lineWidth": 0, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_broker_status_flag", "legendFormat": "{{url}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "10. Broker message age",
      "description": "Seconds since the last MQTT message arrived from each broker. A low sawtooth is healthy (it resets on every message). A line climbing steadily while panel 9 still shows 'connected' means the connection is silently delivering nothing — baselines for those windows will read low or zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 54 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 120 }, { "color": "red", "value": 300 } ] },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false, "thresholdsStyle": { "mode": "dashed" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wmo_wis2_scgrep_broker_last_message_age_seconds", "legendFormat": "{{url}}" }
      ]
    }
  ]
}
