__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.env

# Traefik dashboard credentials (create from traefik/dashboard-users.example)
traefik/dashboard-users

# mkcert-generated TLS certificates (machine-specific; generate locally)
traefik/certs/*.pem

# Log files written by the app (the logs/ dir itself is kept via .gitkeep)
logs/*.log
logs/.purge-*

.idea/
.vscode/
.DS_Store

# Editor swap/backup files
*.sw[a-p]
*~

# Shareable discrepancy reports (not part of the repo)
docs/global-replay-discrepancy-*.md
